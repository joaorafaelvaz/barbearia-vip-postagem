generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Franqueador (tenant). Toda entidade de negócio pertence a uma organização.
model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  units    Unit[]
  posts    Post[]
  media    MediaAsset[]
  accounts ConnectedAccount[]
}

enum UserRole {
  OWNER
  MANAGER
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  email          String   @unique
  name           String?
  passwordHash   String?
  role           UserRole @default(MANAGER)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  units        UserUnit[]

  @@index([organizationId])
}

/// Delegação: quais unidades um gestor pode ver e usar. Administradores veem todas.
model UserUnit {
  userId    String
  unitId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([userId, unitId])
  @@index([unitId])
}

/// Unidade da franquia. `timezone` é um identificador IANA (ex.: America/Sao_Paulo).
model Unit {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  city           String?
  timezone       String   @default("America/Sao_Paulo")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accounts     ConnectedAccount[]
  users        UserUnit[]

  @@index([organizationId])
}

enum Platform {
  FACEBOOK_PAGE
  INSTAGRAM
  GOOGLE_BUSINESS_PROFILE
}

/// Conta de uma plataforma vinculada a uma unidade. Tokens sempre criptografados (AES-GCM).
model ConnectedAccount {
  id             String   @id @default(cuid())
  organizationId String
  unitId         String
  platform       Platform
  /// Page ID, IG User ID ou `accounts/{a}/locations/{l}`
  externalId     String
  displayName    String
  /// Page Access Token (Meta) ou refresh token (Google), criptografados
  accessTokenEnc String
  refreshTokenEnc String?
  tokenExpiresAt DateTime?
  /// Para Instagram: id da Page vinculada (necessário para renovar token)
  parentExternalId String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  unit         Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  targets      PostTarget[]
  externalPosts ExternalPost[]

  @@unique([organizationId, platform, externalId])
  @@index([unitId])
}

enum MediaKind {
  IMAGE
  VIDEO
}

model MediaAsset {
  id             String    @id @default(cuid())
  organizationId String
  kind           MediaKind @default(IMAGE)
  /// chave no bucket
  storageKey     String
  publicUrl      String
  mimeType       String
  width          Int
  height         Int
  bytes          Int
  /// duração em segundos (vídeo); null para imagem
  durationSec    Int?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  posts        PostMedia[]

  @@index([organizationId])
}

enum PostFormat {
  FEED
  STORY
  REEL
}

/// Conteúdo de uma postagem. Um Post gera N PostTargets (um por conta selecionada).
model Post {
  id             String     @id @default(cuid())
  organizationId String
  format         PostFormat @default(FEED)
  caption        String
  /// Horário local escolhido pelo usuário (YYYY-MM-DDTHH:mm) para exibição
  scheduledLocal String
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  media        PostMedia[]
  targets      PostTarget[]

  @@index([organizationId, createdAt])
}

model PostMedia {
  postId   String
  mediaId  String
  position Int    @default(0)

  post  Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  media MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([postId, mediaId])
}

enum TargetStatus {
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELLED
}

/// Uma publicação concreta: Post × ConnectedAccount, com horário em UTC e status próprio.
model PostTarget {
  id                 String       @id @default(cuid())
  organizationId     String
  postId             String
  connectedAccountId String
  /// Em UTC, convertido do fuso da unidade
  scheduledAt        DateTime
  status             TargetStatus @default(SCHEDULED)
  attempts           Int          @default(0)
  externalPostId     String?
  externalUrl        String?
  lastError          String?
  publishedAt        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  post    Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  account ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  metrics TargetMetrics?

  @@unique([postId, connectedAccountId])
  @@index([status, scheduledAt])
  @@index([organizationId, scheduledAt])
}

/// Última leitura de engajamento de uma publicação (coletada periodicamente pelo worker).
model TargetMetrics {
  postTargetId String   @id
  likes        Int      @default(0)
  comments     Int      @default(0)
  shares       Int      @default(0)
  reach        Int      @default(0)
  impressions  Int      @default(0)
  saves        Int      @default(0)
  clicks       Int      @default(0)
  /// métricas que a plataforma não forneceu (ex.: sem permissão read_insights)
  partial      Boolean  @default(false)
  lastError    String?
  fetchedAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  target PostTarget @relation(fields: [postTargetId], references: [id], onDelete: Cascade)

  @@index([fetchedAt])
}

/// Publicação feita fora do sistema, importada da plataforma (últimos 90 dias) para o Analytics.
model ExternalPost {
  id                 String   @id @default(cuid())
  organizationId     String
  connectedAccountId String
  platform           Platform
  externalId         String
  permalink          String?
  caption            String   @default("")
  mediaType          String?
  publishedAt        DateTime
  likes              Int      @default(0)
  comments           Int      @default(0)
  shares             Int      @default(0)
  reach              Int      @default(0)
  impressions        Int      @default(0)
  saves              Int      @default(0)
  clicks             Int      @default(0)
  partial            Boolean  @default(true)
  lastError          String?
  metricsFetchedAt   DateTime?
  importedAt         DateTime @default(now())
  updatedAt          DateTime @updatedAt

  account ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  @@unique([connectedAccountId, externalId])
  @@index([organizationId, publishedAt])
}
