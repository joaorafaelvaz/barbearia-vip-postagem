{
  "name": "franquia-social-publisher",
  "private": true,
  "version": "0.1.0",
  "description": "Publicador social multi-unidade para redes de franquia (Instagram, Facebook, Google Business Profile)",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build && pnpm -r --filter \"./apps/*\" build",
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @fsp/db generate",
    "db:migrate": "pnpm --filter @fsp/db migrate:dev",
    "db:deploy": "pnpm --filter @fsp/db migrate:deploy"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
