# Copie para .env.production no servidor e preencha. Usado pelo docker-compose.prod.yml.

# Banco e fila (nomes dos serviços do compose)
POSTGRES_PASSWORD=troque-esta-senha
DATABASE_URL=postgresql://fsp:troque-esta-senha@postgres:5432/fsp?schema=public
REDIS_URL=redis://redis:6379

# Segredos (gere com: openssl rand -base64 32  /  openssl rand -hex 32)
APP_ENCRYPTION_KEY=
AUTH_SECRET=

# URL pública (usada nos callbacks OAuth e nas URLs de mídia). O setup-server.sh preenche
# AUTH_URL, APP_DOMAIN e WEB_PORT com o que for respondido nas perguntas.
AUTH_URL=https://postagem.barbearia.vip
APP_DOMAIN=postagem.barbearia.vip
# Porta interna do web (só 127.0.0.1; o nginx faz o proxy)
WEB_PORT=3022

# Meta (Facebook Pages + Instagram Business)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0

# Google: Google Meu Negócio e YouTube (mesmo client OAuth; habilite a YouTube Data API v3 no projeto)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# YouTube: public (padrão), unlisted ou private. Apps Google não verificados publicam como privado.
YOUTUBE_PRIVACY_STATUS=public

# TikTok (Login Kit + Content Posting API). Deixe vazio para esconder o botão.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# PUBLIC_TO_EVERYONE (padrão quando a conta permite), FOLLOWER_OF_CREATOR, MUTUAL_FOLLOW_FRIENDS ou SELF_ONLY
TIKTOK_PRIVACY_LEVEL=PUBLIC_TO_EVERYONE

# Mídia: deixe S3_BUCKET vazio para salvar em disco (volume ./data/uploads servido pelo nginx em /uploads/)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

WORKER_CONCURRENCY=5
# Dias que fotos e vídeos ficam no servidor depois de publicados (limpeza diária pelo worker)
MEDIA_RETENTION_DAYS=30
# Opcional: caminho do ffmpeg no worker (padrão: ffmpeg no PATH da imagem)
# FFMPEG_PATH=/usr/bin/ffmpeg

# Avisos WhatsApp: mesma instância WAHA do briefing diário (daily). Vazio desabilita o envio.
# Copie WAHA_URL, WAHA_API_KEY e WAHA_SESSION de /opt/barbearia-daily/.env: a sessão de produção
# é a MESMA que o daily usa (ex.: ceovip) — o valor precisa ser idêntico, senão o WAHA responde 404/422.
WAHA_URL=
WAHA_API_KEY=
WAHA_SESSION=default
# Botão "Gerar com IA" na tela de Avisos. Vazio desabilita o botão.
ANTHROPIC_API_KEY=
