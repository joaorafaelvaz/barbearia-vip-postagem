# Banco e fila
DATABASE_URL="postgresql://fsp:fsp@127.0.0.1:5432/fsp?schema=public"
REDIS_URL="redis://127.0.0.1:6379"

# Chave AES-256-GCM para criptografar tokens de acesso (32 bytes em base64).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=""

# Auth.js
AUTH_SECRET=""
AUTH_URL="http://localhost:3022"
# Cadastro público: em produção fica aberto só até existir a primeira organização.
# true mantém sempre aberto (desenvolvimento e testes).
ALLOW_SIGNUP="true"

# Meta (Facebook Pages + Instagram Business)
META_APP_ID=""
META_APP_SECRET=""
META_GRAPH_VERSION="v26.0"

# Google Business Profile
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Armazenamento de midia (S3 compativel, ex.: Cloudflare R2)
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""
